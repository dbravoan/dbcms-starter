# =============================================================================
# dbCMS - Ejemplo de configuración de producción
# -----------------------------------------------------------------------------
# Copiar a <APP_DIR>/.env en el VPS y rellenar los valores reales.
# NUNCA subir el .env relleno al repositorio.
# =============================================================================

APP_NAME="dbCMS"
# Marca y tema administrativo seleccionados para esta instalación.
# Identificador de un paquete de tema administrativo instalado.
CMS_BRAND=dbcms
# Identificador del tema público instalado; seleccionable desde el panel.
CMS_THEME=db-cyber
# Máximo de POST públicos por minuto e IP: formularios, comentarios, tienda y geo.
CMS_PUBLIC_WRITES_PER_MINUTE=30
APP_ENV=production
APP_KEY=
# Identificador estable y distinto por instalación. Vacío deriva de APP_KEY.
CMS_INSTALLATION_ID=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de datos MySQL/MariaDB del VPS (socket/local)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbcms
DB_USERNAME=dbcms
DB_PASSWORD=

# Sesiones / caché / colas.
# Inicialmente se usan archivos y cola síncrona para permitir el instalador.
# Tras instalar, configurar los controladores y workers necesarios. Para Redis, usar
# SESSION_DRIVER=redis, CACHE_STORE=redis, QUEUE_CONNECTION=redis y ajustar REDIS_HOST.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# CreativeStudio y SocialPublishing llegan desactivados. Para activarlos,
# provisionar Redis y los workers marketing separados del worker general.
# La composición requiere GD, FFmpeg/FFprobe y DejaVu en el entorno que procese esas tareas.
MARKETING_MAX_ARTIFACT_BYTES=536870912
MARKETING_GENERATION_CONCURRENCY=2

# Correo saliente real (SMTP del hosting / proveedor)
MAIL_MAILER=smtp
MAIL_HOST=smtp.tu-dominio.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="no-reply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Passport: dejar vacío para usar storage/oauth-*.key (persistente),
# o pegar aquí las claves PEM si el hosting no permite escribir en storage.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Optimización para buscadores y motores generativos (GEO/SEO).
GEO_ENABLED=true
GEO_SITE_NAME="dbCMS"
GEO_SITE_DESCRIPTION="Plataforma CMS Modular y Agéntica Multi-Mercado"
GEO_AUTHOR="dbCMS"
GEO_LLMS_TXT_MAX_TOKENS=2048
